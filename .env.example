# Aplicação
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
ALLOWED_ORIGIN=http://localhost:3001
SESSION_HOURS=8

# Código necessário somente para criar a primeira conta administradora
SETUP_TOKEN=troque-por-um-codigo-longo-e-seguro

# Banco MariaDB/MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=clinica_dentaria

# Recuperação de senha por e-mail (opcional em desenvolvimento)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dra. Naty <seu-email@exemplo.com>"

# Ative somente quando estiver atrás de um proxy reverso conhecido
TRUST_PROXY=0
